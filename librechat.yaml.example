version: 1.2.0
cache: true

# ──────────────────────────────────────────────────────────────────────
# LLM providers — MiniMax via OpenAI-compatible API.
# Plan token is injected at deploy time from the MINIMAX_API_KEY secret;
# users do NOT need to enter it through the LibreChat UI.
# ──────────────────────────────────────────────────────────────────────
endpoints:
  custom:
    - name: "MiniMax"
      apiKey: "${MINIMAX_API_KEY}"
      baseURL: "https://api.minimax.io/v1"
      models:
        default: ["MiniMax-M2.7"]
        fetch: false
      titleConvo: true
      titleModel: "MiniMax-M2.7"
      modelDisplayLabel: "MiniMax"

mcpSettings:
  # MCP servers using internal IPs/local domains MUST be allow-listed here,
  # otherwise LibreChat blocks the call as SSRF.
  allowedDomains:
    - "office-mcp"

mcpServers:
  office:
    type: streamable-http
    url: http://office-mcp:8080/mcp
    timeout: 120000
    initTimeout: 15000
    chatMenu: true
    title: "Office Documents"
    description: "Create and edit Word, Excel, PowerPoint documents."
    headers:
      # Server-level bearer (auth between LibreChat and office-mcp itself).
      Authorization: "Bearer ${OFFICE_MCP_TOKEN}"
      # User-level bearer: the OIDC access token LibreChat persisted at sign-in
      # (OPENID_REUSE_TOKENS=true). Since OPENID_SCOPE includes Files.ReadWrite,
      # Azure issues this token with aud=Graph + the Files.ReadWrite scope, so
      # office-mcp can call /me/drive/* directly — no On-Behalf-Of exchange.
      X-User-Authorization: "Bearer {{LIBRECHAT_OPENID_ACCESS_TOKEN}}"
      X-LibreChat-User-Id: "{{LIBRECHAT_USER_ID}}"
      X-LibreChat-User-Email: "{{LIBRECHAT_USER_EMAIL}}"
    serverInstructions: |
      This MCP exposes tools to create and edit Office documents (.docx, .xlsx, .pptx).
      Workflow rules:
        1. Before creating a document, read office://rules/<format> for formatting conventions.
        2. Files are addressed by URI. The default scheme is `od://` (the user's OneDrive,
           reached transparently via SSO — no consent prompt needed). When the user does
           not specify a folder, save under `od://AI Generated/<name>` so generated files
           cluster in one place. Example: `od://AI Generated/q3.docx`. The `local://`
           scheme is also available for ephemeral files; `s3://`, `az://`, `sp://` are
           not wired yet.
        3. Do NOT call `fs_list` or `fs_stat` to "scope" OneDrive or "check if a file
           exists" before a `*_create` call — create tools handle auth, overwrite, and
           folder normalization on their own. Go straight to the create tool with your
           chosen `file_uri`.
        4. Build the entire document body in a single create call (pass the full content
           via the create tool's batched argument — e.g. `blocks` for `docx_create`).
           Do not chain create + multiple appends when you already know the content.
        5. Always echo the resulting file_uri to the user so they can retrieve it.
