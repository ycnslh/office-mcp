version: 1.2.0
cache: true

# ──────────────────────────────────────────────────────────────────────
# LLM providers — OpenRouter via OpenAI-compatible API.
# API key is injected at deploy time from the OPENROUTER_API_KEY secret;
# users do NOT need to enter it through the LibreChat UI.
# ──────────────────────────────────────────────────────────────────────
endpoints:
  custom:
    - name: "OpenRouter"
      apiKey: "${OPENROUTER_API_KEY}"
      baseURL: "https://openrouter.ai/api/v1"
      models:
        default: ["nvidia/nemotron-3-super-120b-a12b:free"]
        fetch: true
      titleConvo: true
      titleModel: "nvidia/nemotron-3-super-120b-a12b:free"
      modelDisplayLabel: "OpenRouter"
      # OpenRouter attribution headers (used for rankings / dashboard).
      headers:
        HTTP-Referer: "https://office-mcp.reho.dev"
        X-Title: "office-mcp"

mcpSettings:
  # MCP servers using internal IPs/local domains MUST be allow-listed here,
  # otherwise LibreChat blocks the call as SSRF.
  allowedDomains:
    - "office-mcp"

mcpServers:
  office:
    type: streamable-http
    url: http://office-mcp:8080/mcp
    timeout: 120000
    initTimeout: 15000
    chatMenu: true
    title: "Office Documents"
    description: "Create and edit Word, Excel, PowerPoint documents."
    headers:
      # Server-level bearer (auth between LibreChat and office-mcp itself).
      Authorization: "Bearer ${OFFICE_MCP_TOKEN}"
      # User-level bearer: the OIDC access token LibreChat persisted at sign-in
      # (OPENID_REUSE_TOKENS=true). Since OPENID_SCOPE includes Files.ReadWrite,
      # Azure issues this token with aud=Graph + the Files.ReadWrite scope, so
      # office-mcp can call /me/drive/* directly — no On-Behalf-Of exchange.
      X-User-Authorization: "Bearer {{LIBRECHAT_OPENID_ACCESS_TOKEN}}"
      X-LibreChat-User-Id: "{{LIBRECHAT_USER_ID}}"
      X-LibreChat-User-Email: "{{LIBRECHAT_USER_EMAIL}}"
    serverInstructions: |
      This MCP creates and edits Office documents (.docx, .xlsx, .pptx) on the user's
      Microsoft OneDrive. Workflow rules:
        1. Files are addressed by URI. The only supported scheme is `od://` (the user's
           own OneDrive, reached transparently via LibreChat SSO — no consent prompt).
           When the user does not specify a folder, save under
           `od://AI Generated/<name>` so generated files cluster in one place. Bare
           names like `od://q3.docx` are rewritten server-side to that same folder.
        2. NEVER call `*_read` / `*_create` / any other tool with an `office://` URI:
           `office://rules/...` and `office://templates/...` are MCP *resources*, not
           file paths, and the call fails with UnknownSchemeError. The formatting
           rules are also enforced automatically by the engine — you don't need to
           fetch them to produce well-formatted output.
        3. Do NOT call `fs_list` or `fs_stat` to "scope" OneDrive or "check if a file
           exists" before a `*_create` call — create tools handle auth, overwrite, and
           folder normalization on their own. Go straight to the create tool with your
           chosen `file_uri`.
        4. Build the entire document body in a single create call. Each format has a
           batched argument:
             - `docx_create(blocks=[...])`     — list of {type: heading|paragraph|table, ...}
             - `xlsx_create(sheets=[...])`     — list of {name, writes: [...], formulas: [...]}
             - `pptx_create(slides=[...])`     — list of {type: title|content|two-content|section, ...}
           Do not chain create + multiple appends/writes when you already know the content.
        5. Always echo the resulting file_uri to the user so they can retrieve it.
