# ──────────────────────────────────────────────────────────────────────
# office-mcp — environment variables
# Copy to .env and fill in the values you need.
# ──────────────────────────────────────────────────────────────────────

# Core
OFFICE_MCP_HOST=0.0.0.0
OFFICE_MCP_PORT=8080
OFFICE_MCP_LOG_LEVEL=INFO
OFFICE_MCP_TOKEN=change-me-shared-with-librechat

# Local storage backend
OFFICE_MCP_LOCAL_ROOT=/data
OFFICE_MCP_MAX_FILE_SIZE_MB=50

# Rate limiting (per LibreChat user_id)
OFFICE_MCP_RATE_LIMIT_PER_MIN=60

# Signed download URLs — leave both unset to disable the feature.
# Set signing_secret to any 32+ byte value (can reuse OFFICE_MCP_TOKEN).
# download_base_url must be reachable from users' browsers.
OFFICE_MCP_SIGNING_SECRET=
OFFICE_MCP_DOWNLOAD_BASE_URL=http://localhost:18080
OFFICE_MCP_DOWNLOAD_URL_TTL_SECONDS=900

# ── Microsoft Graph (SharePoint / OneDrive) ─ optional ────────────────
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# ── AWS S3 ─ optional ────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-3

# ── Azure Blob ─ optional ────────────────────────────────────────────
AZURE_STORAGE_CONNECTION_STRING=

# ──────────────────────────────────────────────────────────────────────
# LibreChat dev stack (only used by docker-compose.librechat.yml)
# ──────────────────────────────────────────────────────────────────────
LIBRECHAT_VERSION=v0.8.4
LIBRECHAT_PORT=3080

# Mandatory LibreChat secrets — generate with `openssl rand -hex 32`
CREDS_KEY=
CREDS_IV=
JWT_SECRET=
JWT_REFRESH_SECRET=

# ──────────────────────────────────────────────────────────────────────
# MiniMax LLM (custom OpenAI-compatible endpoint exposed to LibreChat)
# ──────────────────────────────────────────────────────────────────────
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_MODEL=MiniMax-M2.7
