# ──────────────────────────────────────────────────────────────────────
# office-mcp — environment variables
# Copy to .env and fill in the values you need.
# ──────────────────────────────────────────────────────────────────────

# Core
OFFICE_MCP_HOST=0.0.0.0
OFFICE_MCP_PORT=8080
OFFICE_MCP_LOG_LEVEL=INFO
OFFICE_MCP_TOKEN=change-me-shared-with-librechat

# Local storage backend
OFFICE_MCP_LOCAL_ROOT=/data
OFFICE_MCP_MAX_FILE_SIZE_MB=50

# Rate limiting (per LibreChat user_id)
OFFICE_MCP_RATE_LIMIT_PER_MIN=60

# Signed download URLs — leave both unset to disable the feature.
# Set signing_secret to any 32+ byte value (can reuse OFFICE_MCP_TOKEN).
# download_base_url must be reachable from users' browsers.
OFFICE_MCP_SIGNING_SECRET=
OFFICE_MCP_DOWNLOAD_BASE_URL=http://localhost:18080
OFFICE_MCP_DOWNLOAD_URL_TTL_SECONDS=900

# Externally-reachable base URL of this server. Used to build the
# OAuth `redirect_uri` registered with Azure AD. Required for /auth/*
# to function; when unset those endpoints return 503.
OFFICE_MCP_PUBLIC_BASE_URL=http://localhost:8080

# ── Azure AD / Microsoft Graph (delegated OAuth → user OneDrive) ──────
# Confidential web app registration. Add the redirect URI
#   <OFFICE_MCP_PUBLIC_BASE_URL>/auth/callback
# under Authentication → Web in the app reg. Required Graph delegated
# permissions: Files.ReadWrite, User.Read, offline_access, openid, profile.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Default folder for OneDrive writes that omit a folder. A bare URI
# `od://foo.docx` becomes `od://AI Generated/foo.docx`. Set empty to
# disable normalization (writes land at the drive root).
OFFICE_MCP_OD_DEFAULT_FOLDER=AI Generated

# ── AWS S3 ─ optional ────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-3

# ── Azure Blob ─ optional ────────────────────────────────────────────
AZURE_STORAGE_CONNECTION_STRING=

# ──────────────────────────────────────────────────────────────────────
# LibreChat dev stack (only used by docker-compose.librechat.yml)
# ──────────────────────────────────────────────────────────────────────
LIBRECHAT_VERSION=v0.8.4
LIBRECHAT_PORT=3080

# Mandatory LibreChat secrets — generate with `openssl rand -hex 32`
CREDS_KEY=
CREDS_IV=
JWT_SECRET=
JWT_REFRESH_SECRET=

# ──────────────────────────────────────────────────────────────────────
# OpenRouter LLM (custom OpenAI-compatible endpoint exposed to LibreChat)
# ──────────────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=
